# CORS Allowed Origins:
# In production, set this to your deployed frontend domain (e.g., https://schemesathi.vercel.app)
# Multiple origins can be comma-separated: https://schemesathi.vercel.app,http://localhost:5173
# Set to * if testing across any domain without credentials
CORS_ORIGINS=*

# Server Port and Host (Set automatically by Render/Railway/Fly.io)
HOST=0.0.0.0
PORT=8000
DEBUG=False
