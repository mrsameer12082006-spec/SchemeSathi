# SchemeSathi FastAPI Backend Environment Variables
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here

# Groq AI Voice & LLM Integration (Free Tier: 1000 req/day, ultra-low latency)
# Get your free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# Privacy & Session Settings (in minutes)
SESSION_TTL_MINUTES=30
SCHEME_CACHE_TTL_MINUTES=60

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=False
