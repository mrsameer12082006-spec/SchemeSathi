# Supabase PostgreSQL Configuration
SUPABASE_URL=https://yywtrgwhemfwywfnwmxf.supabase.co
SUPABASE_KEY=sb_publishable_hBj_1ALXEzUorlS28aXOPg_AXM-b_xx
