# --- 1. Supabase PostgreSQL & Vector Store ---
SUPABASE_URL=https://yywtrgwhemfwywfnwmxf.supabase.co
# Publishable Anon Key (for public scheme catalog reads)
SUPABASE_KEY=sb_publishable_hBj_1ALXEzUorlS28aXOPg_AXM-b_xx
# Service Role Secret Key (Required for populating pgvector scheme_embeddings with private RLS)
# Find this in: Supabase Dashboard -> Project Settings -> API -> service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJh...your_service_role_secret_key_here

# --- 2. Groq AI Entity Extraction & Conversational LLM ---
# Free Tier available at: https://console.groq.com/keys
# Using llama-3.1-8b-instant with strict Pydantic validation and unit conversion
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- 3. Sarvam AI Voice Pipeline (Indian Regional Voice Accuracy) ---
# Free Developer credits available at: https://dashboard.sarvam.ai
# Saaras (STT) for Hinglish/Hindi transcription + Bulbul (TTS) for natural voice
SARVAM_API_KEY=your_sarvam_api_key_here

# --- 4. Server & Session Settings ---
HOST=127.0.0.1
PORT=8000
DEBUG=True
SESSION_TTL_MINUTES=30
SCHEME_CACHE_TTL_MINUTES=60
